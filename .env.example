# Clé API Anthropic (https://platform.claude.com) — obligatoire
ANTHROPIC_API_KEY=sk-ant-...

# Seulement si ta clé n'est rattachée à aucun workspace (Console → Settings → Workspaces)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Modèles du narrateur (le mode Éco / Hybride / Prestige se choisit en jeu, en haut de l'écran)
NARRATOR_MODEL_STRONG=claude-opus-5-5
NARRATOR_MODEL_FAST=claude-sonnet-5-5

# Effort de réflexion : low | medium | high | xhigh | max
# low = tours rapides ; medium = narration plus fouillée mais plus lente
TURN_EFFORT=low
DOSSIER_EFFORT=medium
